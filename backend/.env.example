PORT=5000
MONGODB_URI=mongodb://localhost:27017/autoqual
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM=AutoQual AI+ <noreply@autoqual.dev>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Daily Report Cron (default: 8am every day)
REPORT_CRON=0 8 * * *

# Groq AI (server-side AI analysis, replaces client-side Puter.js)
GROQ_API_KEY=your_groq_api_key
GROQ_FALLBACK_KEYS=optional_fallback_key1,optional_fallback_key2
GROQ_MODEL=llama-3.3-70b-versatile

# ML service (ml-service/) — Groq is used as an automatic fallback when this is
# unreachable or hasn't loaded a model, so keep ANOMALY_CONFIDENCE_THRESHOLD in
# sync with ml-service/.env if you change it.
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_API_KEY=change_me_to_a_random_secret
ML_SERVICE_TIMEOUT_MS=5000
ANOMALY_CONFIDENCE_THRESHOLD=0.90

# Request-detection ensemble (analyzeRequestEnsemble in watcherService.js) — combines
# deterministic pattern matching with the ML/Groq layer into one weighted verdict.
# Weights apply only when the ML layer is reachable; pattern detection alone carries
# 100% of the weight when it isn't. Threshold is deliberately below PATTERN_DETECTION_WEIGHT
# so a pattern-only match clears it with margin, not exactly on the boundary.
PATTERN_DETECTION_WEIGHT=0.5
ML_DETECTION_WEIGHT=0.5
COMBINED_ALERT_THRESHOLD=0.45
